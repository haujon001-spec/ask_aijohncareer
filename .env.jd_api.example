# JD Automation Portal API — env vars (in addition to OPENROUTER_API_KEY / DEEPSEEK_API_KEY in .env.local)

# Port for backend/jd_api_server.js — must not collide with the main app's PORT (3000)
JD_API_PORT=3010

# Max time (ms) to wait for a single scripts/jd_scorecard_resume.py run before killing it
JD_RUN_TIMEOUT_MS=900000

# Optional override for the python executable. Defaults to .venv/Scripts/python.exe
# (Windows) or .venv/bin/python (posix) if present, else "python"/"python3" on PATH.
# PYTHON_BIN=
