# .env.example - Template for environment variables
# Copy this to .env.local and fill in your actual API keys
# NEVER commit .env.local to git

# LLM Provider API Keys
DEEPSEEK_API_KEY=your-deepseek-key-here
TOGETHER_API_KEY=your-together-api-key
OPENROUTER_API_KEY=your-openrouter-key

# Vite Environment Variables
VITE_BACKEND_URL=http://localhost:3000
# VITE_JD_API_BASE=http://localhost:3010

# LLM Configuration
VITE_LLM_TIMEOUT_MS=5000
VITE_DEFAULT_MODEL=deepseek

# JD Portal auth (backend/jd_api_server.js) — required for MFA session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JD_PORTAL_JWT_SECRET=replace-with-a-random-64-char-hex-string
# Origin allowed to send credentialed requests to the JD API (must match the
# frontend's actual origin — Vite dev server default shown below).
JD_PORTAL_FRONTEND_ORIGIN=http://localhost:5173
