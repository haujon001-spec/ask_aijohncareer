# Environment Variables (.gitignore security rule)
.env
.env.local
.env.vps
.env.*.local

# Data folders (soul.md §4 - never commit raw/processed data)
/data/
/data_raw/
/data_processed/

# Secrets directory (soul.md §4)
# Excluding contents (not the directory itself) so the .example placeholder
# below can be explicitly re-included — git can't un-ignore a file whose
# parent directory is itself excluded.
/secrets/*
!/secrets/jd_portal_auth.json.example
*.pem
*.key
*.p8

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.egg-info/
dist/
build/

# Build outputs
/.next/
out/
.parcel-cache/
.cache/
dist/
build/

# Logs (soul.md §1)
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# IDE & Editor
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.nyc_output/
coverage/
*.lcov

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.bak_*.md
~*

# Generated backup snapshots (backend/backup.js profile snapshots)
/backup/

# Pre-commit
.pre-commit

# Python
.mypy_cache/
.dmypy.json
dmypy.json

# Misc
.turbo/
