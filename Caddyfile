# Caddyfile for John Career Copilot
# Auto-HTTPS with Let's Encrypt

# Caddyfile for John Career Copilot  
# Production Domain Configuration with HTTPS

# Main domain with automatic HTTPS
www.askcareer-ai.com {
    route {
        # JD Automation Portal API — same-origin path routing, so the CSP's
        # connect-src 'self' already covers it with no separate origin needed.
        # handle_path strips the /jd-api prefix before proxying, so
        # /jd-api/api/auth/status -> the jd-api container's real /api/auth/status.
        handle_path /jd-api/* {
            reverse_proxy john-career-copilot-jd-api:3010 {
                header_up X-Forwarded-Proto {http.request.proto}
                header_up X-Forwarded-Host {http.request.host}
            }
        }

        # Everything else — chat app (unchanged behavior)
        handle {
            reverse_proxy john-career-copilot-app:3000 {
                header_up X-Forwarded-Proto {http.request.proto}
                header_up X-Forwarded-Host {http.request.host}
            }
        }
    }

    # Enable gzip compression for responses
    encode gzip
    
    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://openrouter.ai https://api.deepseek.com"
    }
}

# Redirect root domain to www
askcareer-ai.com {
    redir https://www.askcareer-ai.com{uri} permanent
}

# HTTP redirect to HTTPS
http://www.askcareer-ai.com {
    redir https://{host}{uri} permanent
}
