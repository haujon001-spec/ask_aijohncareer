# Caddyfile for John Career Copilot
# Auto-HTTPS with Let's Encrypt
# Replace www.askcareer-ai.com with your actual domain

www.askcareer-ai.com {
    encode gzip

    # Reverse proxy to the backend container
    reverse_proxy localhost:3000 {
        # Headers for proxying
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-Proto {http.request.proto}
        header_up X-Forwarded-Host {http.request.host}
        
        # Timeouts
        transport http {
            dial_timeout 10s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }
    }

    # Security headers
    header / {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "no-referrer-when-downgrade"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Compression
    header / Content-Encoding gzip

    # Cache static assets
    header /assets/* {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Don't cache API responses
    header /api/* {
        Cache-Control "no-cache, no-store, must-revalidate"
    }

    # Log all requests
    log {
        output stdout
        format json
    }
}

# HTTP redirect to HTTPS
http://www.askcareer-ai.com {
    redir https://{host}{uri} permanent
}

# Root domain redirect (optional)
askcareer-ai.com {
    redir https://www.askcareer-ai.com{uri} permanent
}
